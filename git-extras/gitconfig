[push]
  default = simple
  autoSetupRemote = true
[pull]
  rebase = true
[init]
  defaultBranch = main
[log]
  date = format:%m/%d %H:%M
[format]
  pretty = %C(5)%h%Creset %s
[mailmap]
  file = ~/Developer/personal/dotfiles/git-extras/mailmap
[core]
  abbrev = 8
  excludesfile = ~/.gitignore
  pager = delta
  sshCommand = ssh -F /dev/null -o IdentitiesOnly=yes -i ~/.ssh/git
[diff]
  colorMoved = default
  tool = delta
[interactive]
  diffFilter = delta --color-only
[delta]
  navigate = true
[merge]
  conflictstyle = zdiff3
[mergetool]
  keepBackup = false
#[color "diff"]
#  meta = white dim
#  frag = magenta bold
#  commit = yellow bold
#  old = red bold
#  new = green bold
#  whitespace = red reverse
[advice]
  statusHints = false
# Selected via DELTA_FEATURES in ~/.zshrc, which follows LC_TERM_BG alongside
# BAT_THEME. An explicit light/dark also makes delta skip its OSC 11 background
# query, which times out over ssh and races `less` when delta is a diffFilter.
[delta "light-mode"]
  light = true
[delta "dark-mode"]
  dark = true
